# House of Jewelux environment template — replace placeholders locally.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://houseofjewelux.com,https://www.houseofjewelux.com

# Required for the admin portal. Use unique, randomly generated values.
ADMIN_SECRET_PIN=replace-with-a-unique-secret-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Add real payment provider credentials only after configuring the provider.
# PAYMENT_GATEWAY_KEY_ID=
# PAYMENT_GATEWAY_SECRET=
