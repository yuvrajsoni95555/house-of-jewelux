# ===================================================================
# HOUSE OF JEWELUX — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production credentials.
# NEVER commit .env with real secrets to GitHub or public repositories.
# ===================================================================

# 1. Server & Runtime Environment
NODE_ENV=production
PORT=3000
SITE_URL=https://houseofjewelux.com
ALLOWED_ORIGINS=https://houseofjewelux.com,https://www.houseofjewelux.com,http://localhost:3000

# 2. Production Database (Supabase PostgreSQL / Remote Postgres)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
# Note: Use transaction pooler port 6543 or session port 5432 with SSL enabled.
DATABASE_URL=postgresql://postgres:[YOUR-STRONG-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Optional direct Supabase REST API credentials:
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DB_POOL_MAX=10

# 3. Primary Payment Gateway (Razorpay India)
# Obtain from: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# 4. Atelier Security & Access Tokens
# Change this from default 1926 before deploying to production
ADMIN_SECRET_PIN=change_to_secure_8_digit_admin_pin
SESSION_SECRET=generate_random_64_char_secret_for_patron_sessions

# 5. Armored Courier & Logistics (Sequel Logistics / Blue Dart Apex)
ARMORED_COURIER_API_KEY=live_sequel_armored_jaipur_key
