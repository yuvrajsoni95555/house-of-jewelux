# ===================================================================
# HOUSE OF JEWELUX — ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Security & Session Secrets
ADMIN_SECRET_PIN=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_PIN
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# CORS & Domain Routing
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://houseofjewelux.com,https://www.houseofjewelux.com

# Armored Courier Integration (Optional Sandbox Key)
ARMORED_COURIER_API_KEY=

# Payment Gateway (Razorpay / Cashfree)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=
